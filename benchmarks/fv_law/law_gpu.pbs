#!/bin/bash -l
#PBS -N kraken_fv_law
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB:gpu_id=H100
#PBS -l walltime=02:00:00
#PBS -j oe

# Runs setup_law.sh on the compute node first when env/.ready is missing:
# on the login node it competed for a CPU quota and did not finish in 4 h.
# Layout: ~/kraken_law/{src_law,env,depot,logs}.
# Submission from ~/kraken_law: qsub src_law/benchmarks/fv_law/law_gpu.pbs
set -o pipefail
WORKDIR=${WORKDIR:-$HOME/kraken_law}
cd "$WORKDIR" || exit 2
LOGDIR=$WORKDIR/logs
mkdir -p "$LOGDIR"
TAG=${PBS_JOBID%%.*}
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || exit 1
export PATH=$HOME/.juliaup/bin:$PATH
export JULIA_DEPOT_PATH=$WORKDIR/depot
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_OFFLINE=true
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_NUM_THREADS=${NCPUS:-8}
export JULIA_NUM_PRECOMPILE_TASKS=${NCPUS:-8}
if [ ! -f env/.ready ]; then
    JULIA_PKG_OFFLINE=false WORKDIR=$WORKDIR bash src_law/benchmarks/fv_law/setup_law.sh 2>&1 | tee "$LOGDIR/law_setup_$TAG.txt"
    [ "${PIPESTATUS[0]}" -eq 0 ] || exit 3
    touch env/.ready
fi
export KRAKEN_LAW_N=${KRAKEN_LAW_N:-512}
export KRAKEN_LAW_OUTPUT=$LOGDIR/law_$TAG
mkdir -p "$KRAKEN_LAW_OUTPUT"
nvidia-smi --query-gpu=timestamp,memory.used --format=csv,noheader -l 2 > "$LOGDIR/law_nvsmi_$TAG.csv" &
SMI=$!
trap 'kill "$SMI" 2>/dev/null || true' EXIT
KRAKEN_REQUIRE_GPU=1 julia --startup-file=no --project=env src_law/benchmarks/fv_law/law_gpu.jl 2>&1 | tee "$LOGDIR/law_gpu_$TAG.txt"
STATUS=${PIPESTATUS[0]}
echo "FV law status=$STATUS"
exit "$STATUS"
