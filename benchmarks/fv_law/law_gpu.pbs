#!/bin/bash -l
#PBS -N kraken_law
#PBS -l select=1:ncpus=8:ngpus=1:mem=64GB:gpu_id=A100
#PBS -l walltime=02:00:00
#PBS -j oe

# Prepared only. Set WORKDIR to the directory containing src_law, env, depot.
# Supply the allocation with qsub -P externally; no project is embedded here.
set -euo pipefail
WORKDIR=${WORKDIR:-$HOME/kraken_law}
cd "$WORKDIR"
mkdir -p logs
TAG=${PBS_JOBID%%.*}
export PATH=$HOME/.juliaup/bin:$PATH
export JULIA_DEPOT_PATH=$WORKDIR/depot
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_OFFLINE=true
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_NUM_THREADS=${NCPUS:-8}
export KRAKEN_REQUIRE_GPU=1
export KRAKEN_LAW_N=${KRAKEN_LAW_N:-512}
export KRAKEN_LAW_OUTPUT=$WORKDIR/logs/law_$TAG
mkdir -p "$KRAKEN_LAW_OUTPUT"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
julia --startup-file=no --project=env src_law/benchmarks/fv_law/law_gpu.jl 2>&1 | tee "logs/law_$TAG.txt"
