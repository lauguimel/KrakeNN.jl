#!/bin/bash -l
#PBS -N natconv_turan
#PBS -l select=1:ncpus=4:ngpus=1:mem=32GB:gpu_id=A100:host=gpu0n009
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -m n
#
# Submit from the repository root, adding your own project code and Julia:
#   qsub -P <project-code> -v JULIA_BIN=/path/to/julia benchmarks/validation/natconv_gnf/turan_gpu.pbs
# The host pin fixes a known-good A100 (avoid gpu0n001). The Julia depot is
# private to this folder; build it on the login node first (README.md).
# Estimated run time (not measured): about 1 h, at most about 1 h 40 min
# (README.md); walltime kept at 3 h.

cd "$PBS_O_WORKDIR" || exit 1
JULIA_BIN=${JULIA_BIN:-julia}
export JULIA_DEPOT_PATH="$PBS_O_WORKDIR/depot"
export JULIA_CUDA_USE_COMPAT=false
RESULTS="$PBS_O_WORKDIR/benchmarks/validation/natconv_gnf/results"
mkdir -p "$RESULTS" || exit 1

hostname
git -C "$PBS_O_WORKDIR" rev-parse --short HEAD
nvidia-smi || exit 1
"$JULIA_BIN" --project=. -e 'using CUDA; CUDA.versioninfo(); CUDA.functional() || error("CUDA not functional")' || exit 1

status=0
# Step 1: GNF cavity against Turan et al. (2011), six cases on N = 64, 128, 256,
# CUDA Float64 -> turan_comparison.csv and turan_comparison.log.
"$JULIA_BIN" --project=. benchmarks/validation/natconv_gnf/run_turan_comparison.jl \
    --backend=cuda --output-dir="$RESULTS" || status=1
# Step 2: Newtonian 3D thermal refinement check (conduction and Ra = 1e3 with
# wall patches, N = 16), CUDA Float64, re-run with the half-way thermal walls.
"$JULIA_BIN" --project=. benchmarks/validate_thermal_ref_3d_gpu.jl --backend=cuda --FT=Float64 \
    > "$RESULTS/thermal_ref_3d_gpu.log" 2>&1 || status=1
exit $status
