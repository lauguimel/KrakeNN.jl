#!/bin/bash -l
#PBS -N kraken_c4_adjoint
#PBS -l select=1:ncpus=8:ngpus=1:mem=32GB:gpu_id=A100:host=gpu0n009
#PBS -l walltime=02:00:00
#PBS -j oe

# C4 (steady discrete adjoint on the Newton factors, transposed cuDSS solve)
# GPU validation. WORKDIR (default ~/kraken_c4) is prepared on the login node
# by setup_c4.sh (Pkg
# instantiate + precompile there, private depot):
#   src_c4 = feat/fv-c4 (git archive),  env = Kraken dev'd by path + CUDA.jl 6 +
#   CUDSS.jl 1 + ForwardDiff + KernelAbstractions + Test,  depot = private.
# The job runs Pkg offline: C4 test files with KRAKEN_REQUIRE_GPU=1, then the
# cost of one adjoint gradient relative to one Newton solve, cavity 512²/1024².
# nvidia-smi samples the device memory every 2 s into logs/ (peak memory).
# The host is pinned: gpu0n001 fails cuInit. The project code is passed on the
# qsub command line only:  qsub -P <RPID> c4_gpu.pbs

WORKDIR=${WORKDIR:-$HOME/kraken_c4}
cd "$WORKDIR" || exit 2
LOGDIR=$WORKDIR/logs
mkdir -p "$LOGDIR"
TAG=${PBS_JOBID%%.*}

echo "========================================"
echo "Job: $PBS_JOBID   Node: $(hostname)   Start: $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || { echo "ERROR: no GPU"; exit 1; }
echo "========================================"

export PATH=$HOME/.juliaup/bin:$PATH
export JULIA_DEPOT_PATH=$WORKDIR/depot
export JULIA_CUDA_USE_COMPAT=false
export JULIA_PKG_OFFLINE=true
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_NUM_THREADS=${NCPUS:-8}

nvidia-smi --query-gpu=timestamp,memory.used --format=csv,noheader -l 2 > "$LOGDIR/c4_nvsmi_$TAG.csv" &
SMI=$!
KRAKEN_REQUIRE_GPU=1 julia --project=env src_c4/benchmarks/fv_c4/c4_gpu.jl 2>&1 | tee "$LOGDIR/c4_gpu_$TAG.txt"
STATUS=${PIPESTATUS[0]}
kill $SMI 2>/dev/null
echo "peak device memory used (nvidia-smi, MiB): $(sort -t, -k2 -n "$LOGDIR/c4_nvsmi_$TAG.csv" | tail -1)"

echo "========================================"
echo "End: $(date)  status=$STATUS"
echo "========================================"
exit $STATUS
